# Anthropic API key, used for answer generation (Claude). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key, used for embeddings (text-embedding-3-small). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small

# Connection string for the local docker-compose Postgres. Left as-is for a plain
# `uvicorn` run from the host; docker-compose overrides this itself to reach the
# `postgres` service by name instead of localhost.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/rag_db  # pragma: allowlist secret

DEFAULT_COMPANY_ID=demo-company

APP_ENV=development
