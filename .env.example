# --- LLM & embedding providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_knowledge_assistant

# --- Multi-tenancy ---
# Single tenant for now; every document/chunk row is tagged with this id.
DEFAULT_COMPANY_ID=demo-company

# --- App ---
APP_ENV=development
